# Copie este arquivo para .env e ajuste os valores.
# .env NÃO sobe pro git (vide .gitignore).

# Django
SECRET_KEY=django-insecure-troque-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (formato esperado pelo django-environ)
# docker-compose padrão: usuário/senha/db = moodtrack
DATABASE_URL=postgres://moodtrack:moodtrack@localhost:5432/moodtrack

# Variáveis usadas pelo docker-compose (opcionais — defaults idênticos no compose)
POSTGRES_DB=moodtrack
POSTGRES_USER=moodtrack
POSTGRES_PASSWORD=moodtrack
