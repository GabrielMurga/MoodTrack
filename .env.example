# Copie este arquivo para .env e ajuste os valores.
# .env NÃO sobe pro git (vide .gitignore).

# Django
SECRET_KEY=django-insecure-troque-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (formato esperado pelo django-environ)
DATABASE_URL=postgres://moodtrack:moodtrack@localhost:5432/moodtrack

# Criptografia de campos (django-cryptography-5)
# Gere LOCALMENTE com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Em produção, valor REAL deve vir de secret manager — NUNCA commitar.
# Perda da chave = perda dos dados criptografados (sem recuperação).
FIELD_ENCRYPTION_KEY=<gerar-localmente-com-Fernet.generate_key>

# Anthropic (IA)
# 1. Crie conta em console.anthropic.com e gere API key
# 2. Confirme ZERO DATA RETENTION no painel (CLAUDE.md regra 14)
# 3. Só então defina ANTHROPIC_ZDR_CONFIRMED=true
# Sem essas variáveis, a IA fica desabilitada (erro amigável na view).
ANTHROPIC_API_KEY=
ANTHROPIC_ZDR_CONFIRMED=false

